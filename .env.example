# Financial Planner Environment Configuration
# Copy this file to '.env' and fill in your keys for local development.

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g. gemini-2.0-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Fallback environment key name used on GCP Cloud Run
FP_Gemini_Api=your_gemini_api_key_here

# Administrator emails permitted to view login audit logs (comma-separated list)
ADMIN_EMAILS=ney.morais@gmail.com,ney.morais@outlook.com

# Root directory for planning data (raw inputs, scenarios, login audit log).
# Leave unset to use the repository's bundled mock data under ./data.
# Set to an absolute path outside the repository to keep real financial data
# out of git entirely, e.g. FP_DATA_DIR=D:/hexion/financial_planner_data
FP_DATA_DIR=
